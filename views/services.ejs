<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="blob b1"></div>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span>Services</span></nav>
    <h1 class="reveal">Our Dental Services</h1>
    <p class="lead reveal d1">Treatments at Dr. Rawat’s Dental Care, <%= site.address %>.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="chips reveal" aria-label="Jump to a service">
      <% site.services.forEach(function (s) { %><a href="#<%= s.id %>"><%= s.label %></a><% }) %>
    </div>

    <div class="svc-list">
      <% site.services.forEach(function (s, i) { %>
        <article class="svc-row reveal" id="<%= s.id %>">
          <div class="ico big"><%- icon(s.icon) %></div>
          <div>
            <h2><%= s.title %></h2>
            <p><%= s.body %></p>
            <a class="btn btn-book" href="/contact#book"><%- icon('arrow') %> Request an appointment</a>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
